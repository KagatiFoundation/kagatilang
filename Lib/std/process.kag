import "std/io";
import "std/string";

def extern __KG__exit(code: integer) -> void;


def exit(code: integer) -> void {
	__KG__exit(code);
}


def extern __KG_POSIX__execute(program: string, args: string) -> integer;


def extern __KG_POSIX__wait_process(pid: integer) -> integer;


def execute(program: string, args: string) -> integer {
    if (strlen(program) == 0) {
        eprintln("Program name cannot be empty");
        return 1000;
    }

    let pid = __KG_POSIX__execute(program, args);

    if (pid < 0) {
        eprintln("Failed to execute process");
        return 1000;
    }

    return pid;
}


def wait_process(pid: integer) -> integer {
    if (pid < 0) {
        eprintln("Invalid process id");
        return 1000;
    }

    let status = __KG_POSIX__wait_process(pid);
    return status;
}