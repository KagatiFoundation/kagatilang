import "std/io";

def extern __KG_POSIX__create_socket(port: integer) -> integer;

def extern __KG_POSIX__listen_socket(fd: integer, backlog: integer) -> void;

def extern __KG_POSIX__accept_socket_conn(fd: integer) -> integer;

def extern __KG_POSIX__write_socket(fd: integer, msg: string, size: integer) -> void;

def extern __KG_POSIX__close_socket(fd: integer) -> void;

def create_socket(port: integer) -> integer {
    if (port < 0) {
        return 0;
    }
    if (port > 65535) {
        return 0;
    }
	let result =  __KG_POSIX__create_socket(port);
	return result;
}

def listen_socket(fd: integer, backlog: integer) -> void {
    if (fd < 0) {
        eprintln("Invalid socket file descriptor");
    }
	else {
    	__KG_POSIX__listen_socket(fd, backlog);
	}
}

def accept_socket(fd: integer) -> integer {
    let result = __KG_POSIX__accept_socket_conn(fd);
	return result;
}

def write_socket(fd: integer, msg: string, size: integer) -> void {
    if (fd < 0) {
        eprintln("Couldn't write to a socket");
    }
	else {
    	__KG_POSIX__write_socket(fd, msg, size);
	}
}

def close_socket(fd: integer) -> void {
    __KG_POSIX__close_socket(fd);
}