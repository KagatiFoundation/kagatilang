import "std/io";
import "std/socket";
import "std/process";
import "std/string";

def handle_client(fd: integer) -> void {
    let response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 96\r\n\r\n<html><b>Hello World!</b></html>";

    write_socket(fd, response, 96);
    close_socket(fd);
}

def main() -> void {
    let server = create_socket(8080);

    if (server < 0) {
        eprintln("Failed to create socket");
        exit(1);
    }

    listen_socket(server, 10);

    println("Server listening on port 8080");

    loop {
        let client = accept_socket(server);
		println("New client...");

        if (client != -1) {
            handle_client(client);
        }
    }

    close_socket(server);
}