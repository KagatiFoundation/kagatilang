import "std/io";

def square(x: integer) -> integer {
	if (x < 5) {
		return 0;
	}
	else {
		return x * x;
	}
}

def print_table(x: integer) -> void {
	let counter = 1;
    loop if counter < 11 {
		print_int(counter * x);
		counter = counter + 1;
	}
}

def main() -> void {
	let number: integer = 1;

	loop if number < 11 {
		print_table(number);
		number = number + 1;
	}

	let s = square(square(5));
	print_int(s);
}